# Application
ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./esketcher.db

# Jev (TypeSafe)
# mock = deterministic local provider, no key needed. real = calls api.typesafe.ai.
JEV_MODE=mock
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8
JEV_RATE_LIMIT_PER_MINUTE=90
