# Application
ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./esketcher.db

# Jev (TypeSafe)
# mock = deterministic local provider, no key needed. real = calls api.typesafe.ai.
JEV_MODE=mock
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8
JEV_RATE_LIMIT_PER_MINUTE=60
JEV_DAILY_LIMIT_PER_CLIENT=600
# every paid Jev call on this server per UTC day; 0 = unlimited
JEV_DAILY_BUDGET=5000
RATE_LIMIT_PER_MINUTE=300
PROJECT_WRITES_PER_MINUTE=60
MAX_PROJECT_BYTES=1000000
