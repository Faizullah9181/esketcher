# Browser-facing backend URL. Only used for production builds; in dev the
# requests stay same-origin and go through the Vite proxy below.
VITE_API_URL=http://localhost:8000

# 1 = always demo mode (bundled catalog, localStorage saves, Jev off).
# Leave unset: demo mode then starts only when the server is down.
# VITE_OFFLINE=1

# Where the Vite dev server forwards /api to. Overridden to http://backend:8000
# by docker-compose because "localhost" inside the frontend container is itself.
DEV_PROXY_TARGET=http://localhost:8000
